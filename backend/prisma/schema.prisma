generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  slug         String   @unique
  category     String
  price        Decimal
  quantity     Int
  material     String
  description  String
  shortDescription String?
  fullDescription  String?
  features         Json     @default("[]")
  careGuide        String?
  shippingInfo     String?
  dimensions       String?
  weight           String?
  internalNotes    String?
  status           String   @default("draft")
  images       Json
  ebayUrl      String?
  tiktokUrl    String?
  facebookUrl  String?
  instagramUrl String?
  riskLevel    String   @default("safe")
  visible      Boolean  @default(false)
  featured     Boolean  @default(false)
  heroFeatured Boolean  @default(false)
  bestSeller   Boolean  @default(false)
  newArrival   Boolean  @default(false)
  trending     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([visible])
  @@index([featured])
  @@index([heroFeatured])
  @@index([bestSeller])
  @@index([newArrival])
  @@index([trending])
  @@index([status])
  @@index([category])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

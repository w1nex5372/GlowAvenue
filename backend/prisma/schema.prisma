generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  slug         String   @unique
  category     String
  price        Decimal
  quantity     Int
  material     String
  description  String
  images       Json
  ebayUrl      String?
  tiktokUrl    String?
  facebookUrl  String?
  instagramUrl String?
  riskLevel    String   @default("safe")
  visible      Boolean  @default(true)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([visible])
  @@index([featured])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

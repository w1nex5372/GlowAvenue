# ----------------------------------------------------------------------------
# GlamAvenue environment configuration
# Copy this file to ".env" and fill in real values before running.
#   cp .env.example .env
# ----------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=glamavenue
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=glamavenue_db

# Connection string used by the backend / Prisma.
# Host "postgres" is the docker-compose service name.
DATABASE_URL=postgresql://glamavenue:change_this_password@postgres:5432/glamavenue_db

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=please_change_this_to_a_long_random_secret

# Admin login credentials.
# ADMIN_PASSWORD_HASH is a bcrypt hash, NOT a plaintext password.
# Generate one with:   docker compose run --rm backend npm run hash -- "yourPassword"
#                  or:  cd backend && npm run hash -- "yourPassword"
#
# IMPORTANT: bcrypt hashes contain "$". In THIS .env file you must double every
# "$" (write "$$") so Docker Compose does not treat parts of the hash as
# variables. Example: $2a$12$abc...  ->  $$2a$$12$$abc...
ADMIN_EMAIL=admin@glamavenue.co.uk
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

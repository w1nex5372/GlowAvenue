# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Env / secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Prisma generated client
**/node_modules/.prisma/

# Uploaded product images (runtime user content).
# Docker bind mount (./uploads) and the local-dev default (backend/uploads).
/uploads/products/*
!/uploads/products/.gitkeep
backend/uploads/products/*
!backend/uploads/products/.gitkeep

# Database data (if a bind-mount is ever used instead of the Docker volume)
postgres_data/
pgdata/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Claude Code settings
.claude/settings.local.json

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Backups (DB dumps / upload archives)
backups/
*.dump
*.sql.gz
